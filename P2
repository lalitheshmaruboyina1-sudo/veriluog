module CS25B031_session6(
input A,
input B,
input C,
input D,
output Z
    );
    wire T1;
    wire T2;
    wire T3;
    wire T4;
    not (A_NOT,A);
    not(B_NOT,B);
    not(C_NOT,C);
    not(D_NOT,D);
    and(T1,A,B,C);
    and(T2,A_NOT,B_NOT,C_NOT);
    and(T3,B,C,D);
    and(T4,B_NOT,C_NOT,D_NOT);
    
    or(Z,T1,T2,T3,T4);
   
endmodule
